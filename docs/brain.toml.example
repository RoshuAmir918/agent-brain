[brain]
vault = "memory"
agent_dir = "agent"
people_dir = "people"
agents_dir = "agents"
human_profile = "human/Profile.md"
sources_dir = "sources"
hermes_dir = "hermes"
human_name = "Human"
agent_name = "Agent"
owner_user_ids = []   # the owner's permanent platform ids, e.g. "demiurge:<id>"; a bare id matches any platform
maintainers = []   # same form, for whoever keeps the machinery running
log_dirs = []   # folders under agent_dir that hold receipts, ledgers or results; never notes, never hot
skill_prefix = "brain-"
timezone = "America/Los_Angeles"   # the owner's zone: the export's "yesterday", digest days, health and audit dates
update_source = "git+https://github.com/RoshuAmir918/agent-brain"   # "" disables the nightly auto-update

[context]   # each key also has a BRAIN_* environment override; see docs/engine.md
hot_words = 6000
sections = ["start", "current", "goals", "triggers", "tasks", "hot", "directory"]
prefetch = true
prefetch_limit = 6
prefetch_chars = 1500
prefetch_form = "names"
hot_threshold = 7
warm_threshold = 28
